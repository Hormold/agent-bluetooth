# Same LiveKit server the daemon uses. These match `livekit-server --dev`.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# OpenAI Realtime plugin. Required to speak on a call. Worker registration
# does not use this key.
OPENAI_API_KEY=

# Who the agent works for ("Nikita's assistant").
OWNER_NAME=
# The agent-bluetooth daemon, used to place calls.
AGENT_BLUETOOTH_URL=http://127.0.0.1:8080
